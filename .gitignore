# RIGAD API response cache — regenerated on demand, never committed
data/cache/

# Derived embeddings — rebuilt in ~40s from the committed profiles
data/sample/embeddings*.npz

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/

# Jupyter
.ipynb_checkpoints/

# Secrets
.env

# macOS
.DS_Store

# Drafts under analysis and anything generated from them. Never commit
# unpublished work belonging to you or to anyone else.
notebooks/*.docx
notebooks/*.pdf
notebooks/**/*.docx
notebooks/**/*.pdf
notebooks/*.csv
docs/*.docx
docs/RIGAD_final_report.*

